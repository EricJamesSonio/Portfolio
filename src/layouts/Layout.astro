---
export interface Props {
  title?: string;
}
const { title = 'Eric James Sonio — Portfolio' } = Astro.props;
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="Eric James Sonio — Fullstack Developer & Backend Specialist. CS student at College of Mary Immaculate.">
  <meta name="color-scheme" content="light dark">
  <title>{title}</title>

  <!-- Apply the saved / OS theme BEFORE first paint so there is no flash. -->
  <script is:inline>
    (function () {
      try {
        var saved = localStorage.getItem('theme');
        var dark = saved
          ? saved === 'dark'
          : window.matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.setAttribute('data-theme', dark ? 'dark' : 'light');
      } catch (e) {
        document.documentElement.setAttribute('data-theme', 'light');
      }
    })();
  </script>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700;900&family=DM+Sans:wght@300;400;500;600&family=DM+Mono:wght@400;500&display=swap" rel="stylesheet">
</head>
<body>
  <slot />
  <script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js"></script>
  <script src="/Portfolio/scripts/main.js" is:inline></script>

  <!-- Shared theme toggle API. Phase 8 upgrades this to a View-Transitions ripple. -->
  <script is:inline>
    window.__theme = {
      get: function () {
        return document.documentElement.getAttribute('data-theme') === 'dark' ? 'dark' : 'light';
      },
      set: function (theme) {
        document.documentElement.setAttribute('data-theme', theme);
        try { localStorage.setItem('theme', theme); } catch (e) {}
        window.dispatchEvent(new CustomEvent('themechange', { detail: { theme: theme } }));
      },
      toggle: function () {
        this.set(this.get() === 'dark' ? 'light' : 'dark');
      }
    };
  </script>
</body>
</html>

<style is:global>
  @import '../styles/base.css';
  @import '../styles/ui.css';
  @import '../styles/navbar.css';
  @import '../styles/hero.css';
  @import '../styles/about.css';
  @import '../styles/tech.css';
  @import '../styles/projects.css';
  @import '../styles/contact.css';
  @import '../styles/footer.css';
  @import '../styles/responsive.css';
</style>
