# Environment variables for the AI chatbot (Phase 9).
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# These are read on the SERVER only (api/chat.js). Never prefix them with PUBLIC_ or VITE_,
# otherwise the key would be shipped to the browser.

# Required. Create a key at https://console.groq.com/keys
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile when unset.
GROQ_MODEL=
