---
import Card from './Card.astro';
import { getCerts } from '../data/certs.js';

const certs = await getCerts();
---

<Card title="CERTIFICATIONS" id="certifications" labelled>
  {certs.length > 0 ? (
    <ul class="cert-list custom-scroll">
      {certs.map((c) => (
        <li>
          {c.hasImage ? (
            <button class="cert-item" type="button" data-cert-src={c.src} data-cert-name={c.name}>
              <span class="cert-text">
                <span class="cert-name">{c.name}</span>
                <span class="cert-issuer">{c.issuer}</span>
              </span>
              <span class="cert-expand" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor">
                  <path d="M21 11h-8v8H9v-8H1V9h8V1h4v8h8z" />
                </svg>
              </span>
            </button>
          ) : (
            <div class="cert-item is-static">
              <span class="cert-text">
                <span class="cert-name">{c.name}</span>
                <span class="cert-issuer">{c.issuer}</span>
              </span>
            </div>
          )}
        </li>
      ))}
    </ul>
  ) : (
    <!-- Honest empty state: the existing site had no certifications and no images were supplied. -->
    <p class="cert-empty">
      No certifications listed yet.
      <span class="cert-todo">TODO: add certificates in <code>src/data/certs.js</code>.</span>
    </p>
  )}
</Card>

<!-- Lightbox: only present when at least one certificate has an image -->
{certs.some((c) => c.hasImage) && (
  <div class="lightbox" id="cert-lightbox" role="dialog" aria-modal="true" aria-label="Certificate image" hidden>
    <button class="lightbox-close" type="button" aria-label="Close certificate">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
        <path d="M19 6.41 17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z" />
      </svg>
    </button>
    <img class="lightbox-img" src="" alt="" />
  </div>
)}
