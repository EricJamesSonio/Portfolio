---
import Divider from './Divider.astro';
import stack from '../data/stack.js';
import { getIcon } from '../data/stackIcons.js';

// Static grid, not a carousel. Each tech renders exactly ONCE - the previous marquee needed
// four identical runs to loop seamlessly, which meant every card appeared four times.
const rows = stack.map((group) => {
  const cards = group.techs.map((tech) => {
    const icon = getIcon(tech.icon);
    return { name: tech.name, icon, symbolId: null };
  });

  // Widest label in THIS group, counted in characters. The whole site is monospace, so one
  // character is exactly 1ch and CSS can turn this number straight into the minimum column
  // width - the "longest text wins" rule.
  //
  // Phase 16 derived the column count from the ITEM count (`Math.min(techs.length, 8)`),
  // which handed Tools & Testing 8 narrow columns: after the 30px icon, the 12px gap and the
  // 32px padding there was ~101px of text, about 10 monospace characters. Every longer name
  // then hit `overflow-wrap: anywhere` and split mid-word ("Postma n", "OpenRo uter",
  // "Copilo t"). Sizing from the text instead means no name can break at any breakpoint.
  const longest = cards.reduce((n, c) => Math.max(n, c.name.length), 0);

  return { label: group.label, longest, cards };
});

// Icons live in ONE hidden sprite and each card just does <use href="#id">.
const symbols = [];
const symbolIdByMarkup = new Map();
for (const row of rows) {
  for (const card of row.cards) {
    if (!card.icon) continue;
    // Dedupe by markup: ASP.NET and MSTest both resolve to the .NET mark, so only one symbol is
    // emitted - but BOTH cards still get a symbolId.
    if (!symbolIdByMarkup.has(card.icon.body)) {
      const id = `stack-icon-${symbols.length + 1}`;
      symbolIdByMarkup.set(card.icon.body, id);
      symbols.push({ id, body: card.icon.body });
    }
    card.symbolId = symbolIdByMarkup.get(card.icon.body);
  }
}
---

<!-- Own section: deliberately NOT a .card, so the grid reads as a full-width band rather than
     content trapped in a box. `id="tech"` is preserved so old #tech links still land here. -->
<section class="stack-section" id="tech" aria-labelledby="stack-heading">
  <!-- Signature divider: the same neon-blue fading hairlines + ultra-wide-tracked caption as
       every other band (ITERATE. BUILD. DEPLOY. / CONSISTENCY / RECOGNITION | SOCIALS).
       This replaces the old left-aligned "TECH STACK" h2, which was the only band without one.
       The real h2 is kept visually-hidden so `aria-labelledby` and the heading order stay valid
       - the same pattern `Projects.astro` uses for its own band title. -->
  <h2 id="stack-heading" class="visually-hidden">Tech Stack</h2>
  <Divider>TECH STACK</Divider>

  <!-- Icon sprite: rendered once, referenced by every card below. -->
  <svg class="stack-icon-sprite" aria-hidden="true" focusable="false" width="0" height="0">
    {symbols.map((s) => (
      <symbol id={s.id} viewBox="0 0 24 24" set:html={s.body} />
    ))}
  </svg>

  <div class="stack-groups">
    {rows.map((row) => (
      <div class="stack-group">
        <div class="stack-label">
          <span class="micro-label">{row.label}</span>
          <span class="stack-count">{row.cards.length}</span>
          <span class="stack-hairline" aria-hidden="true"></span>
        </div>

        {/* --stack-label-ch is the longest label in this group, in characters. CSS turns it
            into the minimum column width (see tech-stack.css). */}
        <ul class="stack-grid" style={`--stack-label-ch: ${row.longest}`}>
          {row.cards.map((card) => (
            <li class="stack-card">
              {card.symbolId && (
                /* Official brand colour, per theme. --brand-light / --brand-dark come from
                   stackIcons.js, already corrected to clear 3:1 on the card background.
                   No width/height attributes: .stack-icon is sized in CSS from --stack-icon,
                   so the grid maths and the rendered icon can never drift apart. */
                <span class="stack-card-icon" aria-hidden="true">
                  <svg
                    class="stack-icon"
                    viewBox="0 0 24 24"
                    style={`--brand-light:${card.icon.light};--brand-dark:${card.icon.dark}`}
                  >
                    <use href={`#${card.symbolId}`} />
                  </svg>
                </span>
              )}
              <span class="stack-card-name">{card.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>