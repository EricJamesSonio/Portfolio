---
import stack from '../data/stack.js';
import { getIcon } from '../data/stackIcons.js';

// Static grid, not a carousel. Each tech renders exactly ONCE - the previous marquee needed
// four identical runs to loop seamlessly, which meant every card appeared four times.
const rows = stack.map((group) => ({
  label: group.label,
  // Column count per group so a 4-item row never stretches four cards across the full width
  // (auto-fit would do exactly that and it looks sparse). Capped at 8; Tools wraps to 2 rows.
  cols: Math.min(group.techs.length, 8),
  cards: group.techs.map((tech) => {
    const icon = getIcon(tech.icon);
    return { name: tech.name, icon, symbolId: null };
  }),
}));

// Icons live in ONE hidden sprite and each card just does <use href="#id">.
const symbols = [];
const symbolIdByMarkup = new Map();
for (const row of rows) {
  for (const card of row.cards) {
    if (!card.icon) continue;
    // Dedupe by markup: ASP.NET and MSTest both resolve to the .NET mark, so only one symbol is
    // emitted - but BOTH cards still get a symbolId.
    if (!symbolIdByMarkup.has(card.icon.body)) {
      const id = `stack-icon-${symbols.length + 1}`;
      symbolIdByMarkup.set(card.icon.body, id);
      symbols.push({ id, body: card.icon.body });
    }
    card.symbolId = symbolIdByMarkup.get(card.icon.body);
  }
}
---

<!-- Own section: deliberately NOT a .card, so the grid reads as a full-width band rather than
     content trapped in a box. `id="tech"` is preserved so old #tech links still land here. -->
<section class="stack-section" id="tech" aria-labelledby="stack-heading">
  <h2 class="stack-heading" id="stack-heading">TECH STACK</h2>

  <!-- Icon sprite: rendered once, referenced by every card below. -->
  <svg class="stack-icon-sprite" aria-hidden="true" focusable="false" width="0" height="0">
    {symbols.map((s) => (
      <symbol id={s.id} viewBox="0 0 24 24" set:html={s.body} />
    ))}
  </svg>

  <div class="stack-groups">
    {rows.map((row) => (
      <div class="stack-group">
        <div class="stack-label">
          <span class="micro-label">{row.label}</span>
          <span class="stack-count">{row.cards.length}</span>
          <span class="stack-hairline" aria-hidden="true"></span>
        </div>

        <ul class="stack-grid" style={`--stack-cols: ${row.cols}`}>
          {row.cards.map((card) => (
            <li class="stack-card">
              {card.symbolId && (
                /* Official brand colour, per theme. --brand-light / --brand-dark come from
                   stackIcons.js, already corrected to clear 3:1 on the card background. */
                <span class="stack-card-icon" aria-hidden="true">
                  <svg
                    class="stack-icon"
                    viewBox="0 0 24 24"
                    width="30"
                    height="30"
                    style={`--brand-light:${card.icon.light};--brand-dark:${card.icon.dark}`}
                  >
                    <use href={`#${card.symbolId}`} />
                  </svg>
                </span>
              )}
              <span class="stack-card-name">{card.name}</span>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>