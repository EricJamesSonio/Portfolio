---
import Divider from './Divider.astro';
import GithubGraph from './react/GithubGraph.jsx';
import { githubUsername, githubProfileUrl, calendarTheme } from '../data/github.js';
---

<section class="gh-section" id="github" aria-labelledby="gh-heading">
  <Divider>CONSISTENCY</Divider>

  <div class="gh-card card">
    <header class="card-head">
      <h2 class="card-title" id="gh-heading">GITHUB CONTRIBUTIONS</h2>
      <a class="gh-profile-link" href={githubProfileUrl} target="_blank" rel="noreferrer">
        View GitHub Profile <span aria-hidden="true">↗</span>
      </a>
    </header>

    <!-- Fallback if JS is unavailable: a plain link to the profile. -->
    <noscript>
      <p class="gh-noscript">
        The contribution graph needs JavaScript.
        <a href={githubProfileUrl} target="_blank" rel="noreferrer">View the GitHub profile</a> instead.
      </p>
    </noscript>

    <p class="gh-scroll-hint" aria-hidden="true">Swipe the grid to see the full year →</p>

    <div class="gh-panel-wrap">
      {/* `client:idle` (was `client:visible`) so the graph mounts as soon as the browser goes idle
          after first paint — by the time anyone scrolls down it is already rendered, instead of
          popping in at the section. `client:idle` rather than `client:load` so it never competes
          with the hero for first paint. */}
      <GithubGraph
        client:idle
        username={githubUsername}
        profileUrl={githubProfileUrl}
        theme={calendarTheme}
      />
    </div>
  </div>
</section>
