---
import Experience from '../components/Experience.astro';
import Education from '../components/Education.astro';
import About from '../components/About.astro';
---

<!-- Bento grid: one column below lg, 35% / 65% columns from lg.
     Left column: Experience + Education. Right column: About only.
     Tech Stack moved OUT to its own full-bleed section (see `TechStack.astro`), which now
     owns the `#tech` anchor so old links still land in the right place. -->
<section class="bento" id="about" aria-label="About, experience and education">
  <div class="bento-col bento-col-left">
    <Experience />
    <Education />
  </div>
  <div class="bento-col bento-col-right">
    <About />
  </div>
</section>
